{
  "expo": {
    "name": "FibraOpticaApp",
    "slug": "FibraOpticaApp",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/logo3.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo3.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "jsEngine": "hermes",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app necesita acceso a la cámara para tomar fotos de instalaciones de fibra óptica",
        "NSMicrophoneUsageDescription": "Esta app necesita acceso al micrófono para grabar video",
        "NSPhotoLibraryUsageDescription": "La app necesita acceso a tus fotos para escanear códigos QR desde la galería."
      },
      "bundleIdentifier": "com.yourcompany.fibraopticaapp"
    },
    "android": {
      "enableDexingArtifactTransform": false,
      "softwareKeyboardLayoutMode": "pan",
      "jsEngine": "hermes",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ],
      "package": "com.yourcompany.fibraopticaapp",
      "versionCode": 21,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo3.png",
        "backgroundColor": "#ffffff"
      },
      "allowInternet": true
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "web": {
      "favicon": "./assets/images/logo3.png",
      "bundler": "metro"
    },
    "assetBundlePatterns": [
      "assets/images/*",
      "assets/fonts/*"
    ],
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-camera",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-image-picker",
         {
          "photosPermission": "La app necesita acceso a tus fotos para escanear códigos QR desde la galería.",
          "cameraPermission": "La app necesita acceso a la cámara para escanear códigos QR."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b18ede45-96ef-4cb0-847a-68e5e0d0a591"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
